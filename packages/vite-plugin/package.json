{
  "name": "vite-plugin-ai-lambda",
  "version": "0.2.3",
  "description": "Compile natural-language array operations into JavaScript during Vite builds.",
  "license": "ISC",
  "type": "module",
  "keywords": [
    "vite-plugin",
    "ai-lambda",
    "rollup-plugin",
    "rolldown-plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "typescript": ">=7.0.2 <8.0.0",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  }
}
